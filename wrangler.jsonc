// Cloudflare Workers config for the Nine3 studio portal (TanStack Start + Nitro cloudflare preset).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nine3-studio",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "studio.nine3designs.co.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://arakmsikdjguhyqtqbsm.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gzvw3Zf8VhfoLV0xzIzuPA_Q07tu8cp"
  }
}
